{
  "name": "copy-my-things",
  "version": "0.1.0",
  "description": "A local-first clipboard utility with snippets, a quick launcher, and an encrypted vault",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun scripts/run.ts dev",
    "build": "bun run typecheck && electron-vite build",
    "start": "bun scripts/run.ts start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "bun scripts/check-native.ts",
    "rebuild": "bun scripts/check-native.ts",
    "test:electron": "bun run build && bun scripts/run.ts smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:electron:dev": "bun scripts/run.ts dev -- --smoke-test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-vite": "^6.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "better-sqlite3",
    "uiohook-napi"
  ]
}
